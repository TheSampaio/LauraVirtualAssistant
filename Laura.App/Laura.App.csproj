<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Matches Laura.Platform.Windows so the WinRT speech APIs flow through. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Laura.App</RootNamespace>
    <AssemblyName>Laura</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\Data\icon.ico</ApplicationIcon>
    <!-- Required by the LibraryImport generator used by the global hotkey and dark window frame. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      WFO1000/CA1859: rules aimed at the visual designer and micro-optimization of
      UI constructors; this interface is built entirely in code.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1716;WFO1000;CA1859</NoWarn>
    <Description>Tray application and settings interface for the Laura assistant.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Laura.Core\Laura.Core.csproj" />
    <ProjectReference Include="..\Laura.Platform.Windows\Laura.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Data\icon.ico" Link="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
