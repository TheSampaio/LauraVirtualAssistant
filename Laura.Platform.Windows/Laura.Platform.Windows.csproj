<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows 10 target unlocks WinRT capture and native desktop APIs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Laura.Platform.Windows</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>9.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1716</NoWarn>
    <!-- Required by the LibraryImport generator used for the Windows API calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Google Live audio, protected credentials and Windows desktop adapters for Laura.Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded MIT-licensed llama.cpp binding/backend; the pinned native revision includes Qwen3.5. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- Offline multilingual ASR, distinct from speech synthesis; both packages are MIT licensed. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Official minimal MCP client; framing/version negotiation remain outside the cognitive Core. Apache-2.0. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.13" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Laura.Core\Laura.Core.csproj" />
  </ItemGroup>

</Project>
